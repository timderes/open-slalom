{
  "private": true,
  "name": "open-slalom",
  "productName": "openSlalom",
  "description": "Open-source timing and results management software for Kart Slalom competitions and training",
  "version": "1.3.0",
  "author": "Tim Deres",
  "main": "app/main.js",
  "type": "module",
  "scripts": {
    "dev": "nextron",
    "build": "nextron build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck:renderer": "tsc --noEmit -p renderer/tsconfig.json",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@mantine/core": "^9.4.1",
    "@mantine/dates": "^9.4.1",
    "@mantine/form": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@mantine/modals": "^9.4.1",
    "@mantine/notifications": "^9.4.1",
    "@tabler/icons-react": "^3.44.0",
    "dayjs": "^1.11.21",
    "dexie": "^4.4.2",
    "dexie-export-import": "^4.4.0",
    "dexie-react-hooks": "^4.4.0",
    "electron-log": "^5.4.4",
    "electron-serve": "^1.3.0",
    "electron-store": "^8.2.0",
    "next": "^16.2.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-use-precision-timer": "^3.5.6",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "^4.1.6",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "nextron": "^10.0.0",
    "postcss": "^8.5.25",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
